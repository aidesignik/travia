generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CLIENT
  CARRIER
  ADMIN
}

enum CarrierStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum VehicleAmenity {
  AC
  WIFI
  USB
  TOILET
}

enum VehicleType {
  VAN
  MINIBUS
  MIDIBUS
  COACH
  DOUBLE_DECKER
}

// Mirrors the keys of DRIVER_COLORS in src/lib/driver-colors.ts — that
// module is the source of truth for the actual bg/fg/accent hex values.
enum DriverColor {
  lavender
  periwinkle
  sky
  teal
  mint
  sage
  butter
  peach
  rose
  orchid
}

enum RideStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BlockReason {
  MAINTENANCE
  DAY_OFF
  VACATION
  OTHER
}

enum DocumentType {
  CONTRACT
  CONFIRMATION
  INVOICE
}

enum DocumentStatus {
  PENDING
  GENERATED
  FAILED
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         Role     @default(CLIENT)
  name         String?
  // Set for client accounts that book on behalf of an organization (a
  // sports federation, a company, a school) rather than as an individual —
  // `name` then holds the contact person, this holds who they're booking
  // for. Null for an ordinary individual client.
  companyName  String?
  image        String?
  phone        String?
  locale       String   @default("sr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  carrier Carrier?
  rides   Ride[]   @relation("ClientRides")

  passwordResetTokens PasswordResetToken[]
}

// Holds the SHA-256 hash of the reset token, never the raw value — the raw
// token only ever exists in the emailed link, so a database leak alone
// can't be used to take over an account. One outstanding (unused) token
// per user: requesting a new one invalidates the last.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Carrier {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  companyName          String
  taxId                String   @unique
  registrationNumber   String?
  legalRepresentative  String?
  contactEmail         String
  contactPhone         String?
  city                 String
  address              String?
  postalCode           String?
  description          String?
  licenseInfo          String?
  logoUrl              String?
  photos               String[] @default([])

  ratePerKm Decimal? @db.Decimal(10, 2)
  fixedFee  Decimal? @db.Decimal(10, 2)

  status    CarrierStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  vehicles Vehicle[]
  drivers  Driver[]
  rides    Ride[]
  blocks   Block[]
}

model Vehicle {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  type            VehicleType
  model           String
  licensePlate    String?
  year            Int?
  seats           Int
  amenities       VehicleAmenity[] @default([])
  otherAmenities  String?
  photos          String[]         @default([])
  status          VehicleStatus    @default(ACTIVE)

  lastRegistrationDate DateTime?
  lastInspectionDate   DateTime?
  documentUrls         String[]  @default([])

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  drivers DriverVehicle[]
  rides   Ride[]
  blocks  Block[]

  @@index([carrierId])
}

model Driver {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  name          String
  phone         String
  isAvailable   Boolean  @default(true)
  licenseNumber String?

  // Assigned once at creation (least-used color among the carrier's
  // existing drivers) and only ever changed explicitly via the color
  // picker — never derived from the name, so renaming a driver can't
  // change their color. Nullable as a safety net: DriverAvatar falls back
  // to a deterministic hash of the driver id if this is missing/invalid.
  avatarColor DriverColor?

  // Required driver documents — ID card, driver's license, CPC and medical
  // certificate — each with an expiry date and a front/back photo.
  idCardExpiry DateTime?
  idCardFrontUrl String?
  idCardBackUrl  String?

  licenseExpiry   DateTime?
  licenseFrontUrl String?
  licenseBackUrl  String?

  cpcExpiry   DateTime?
  cpcFrontUrl String?
  cpcBackUrl  String?

  medicalCertExpiry   DateTime?
  medicalCertFrontUrl String?
  medicalCertBackUrl  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles DriverVehicle[]
  rides    Ride[]
  blocks   Block[]

  @@index([carrierId])
}

model DriverVehicle {
  driverId  String
  vehicleId String
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([driverId, vehicleId])
}

// A client's trip, from first submission through to completion. Starts
// unassigned (carrierId/vehicleId/driverId all null, status PENDING) and
// visible to every approved carrier; the first carrier to assign a vehicle
// and driver claims it (carrierId gets set then). Replaces what used to be
// three separate records (BookingRequest -> Offer -> Booking) — assigning
// a vehicle/driver is now a direct edit, not a priced offer needing accept.
model Ride {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientRides", fields: [clientId], references: [id])

  carrierId String?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  pickupCity          String
  pickupLocation      String
  pickupLat           Float?
  pickupLng           Float?
  destinationCity     String
  destinationLocation String
  destinationLat      Float?
  destinationLng      Float?

  departureAt         DateTime
  isRoundTrip         Boolean   @default(false)
  returnAt            DateTime?
  // The return leg defaults to the outbound leg reversed (same pickup/
  // destination/stops) and these stay null — set only when the carrier
  // picks a different route for the way back.
  returnPickupCity          String?
  returnPickupLocation      String?
  returnPickupLat           Float?
  returnPickupLng           Float?
  returnDestinationCity     String?
  returnDestinationLocation String?
  returnDestinationLat      Float?
  returnDestinationLng      Float?
  passengerCount      Int
  // Computed server-side from geocoded pickup/stops/destination, or entered
  // directly by the carrier when they create+assign a ride themselves.
  estimatedDistanceKm Float?
  specialRequests     String?

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("RSD")

  status    RideStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  stops     RideStop[]
  documents Document[]

  @@index([clientId])
  @@index([carrierId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  // Matches the carrier calendar's per-week query (carrierId + status IN +
  // departureAt range) — without it, Postgres falls back to the lone
  // carrierId index and filters/sorts the rest in memory, which gets
  // slower as a carrier's ride history grows.
  @@index([carrierId, status, departureAt])
  // Matches the unassigned-queue query (status + vehicleId IS NULL +
  // driverId IS NULL) — that query is marketplace-wide, not scoped to one
  // carrier, so it's the one request on this page that grows with total
  // site activity rather than just one carrier's own data.
  @@index([status, vehicleId, driverId])
}

enum RideLeg {
  OUTBOUND
  RETURN
}

model RideStop {
  id     String @id @default(cuid())
  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  // Only ever RETURN for a round trip's custom return route (see
  // Ride.returnPickupCity) — order restarts at 0 within each leg.
  leg      RideLeg @default(OUTBOUND)
  order    Int
  city     String
  location String
  lat      Float?
  lng      Float?

  @@index([rideId])
}

// Non-ride unavailability on a vehicle or driver (maintenance, day off,
// vacation) — exactly one of vehicleId/driverId is set, enforced in the API
// layer rather than the schema, matching this app's existing pattern of
// app-level validation over DB check constraints.
model Block {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  startAt DateTime
  endAt   DateTime
  reason  BlockReason
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carrierId])
  @@index([vehicleId])
  @@index([driverId])
}

model Document {
  id     String @id @default(cuid())
  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  type      DocumentType
  status    DocumentStatus @default(PENDING)
  number    String?
  fileUrl   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Set together, only after a successful send — lets the UI show "Sent to
  // x@y.com on <date>" instead of just a bare "Email" action with no
  // record of whether/where it already went.
  emailedAt DateTime?
  emailedTo String?

  @@unique([rideId, type])
  @@index([rideId])
}

// Fixed-window rate limiting for auth endpoints (login, register, forgot
// password). A Postgres table rather than in-memory/Redis — serverless
// functions don't share memory across instances, and this app already has
// Postgres with nothing else to set up.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
}
