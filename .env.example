DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_new?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Locally it can match DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/portfolio_new?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (carrier login/signup) — from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: from https://console.anthropic.com/settings/keys — powers the
# "suggested expiry date" auto-read on uploaded driver documents and the
# in-app Assistant chat (books rides, answers schedule questions; see
# src/lib/assistant). Without it, document upload still works without the
# suggestion, and the Assistant button is hidden.
ANTHROPIC_API_KEY=""

# Google Maps Platform (optional). Turns the "exact location" field into a
# Google Places search and calculates road distance with Google Routes.
# Enable "Places API (New)" and "Routes API", restrict the key to those two
# APIs, and set daily quota caps in Google Cloud so usage stays in the free
# tier. Leave empty to keep the free OpenStreetMap lookup + plain text field.
GOOGLE_MAPS_API_KEY=""

NEXT_PUBLIC_DEFAULT_LOCALE="en"

DEFAULT_RATE_PER_KM="120"
DEFAULT_FIXED_FEE="1500"
DEFAULT_CURRENCY="RSD"

DOCUMENT_STORAGE_DIR="./storage/documents"

# Optional: from a Vercel Blob store (Vercel dashboard → Storage → Create
# Database → Blob), auto-populated as a project env var once connected.
# Without it, generated documents and uploaded files (vehicle docs/photos,
# driver docs, carrier logos) fall back to local disk — fine for local dev,
# but required in production since Vercel's filesystem doesn't persist
# between requests.
BLOB_READ_WRITE_TOKEN=""

# Optional: from https://resend.com/api-keys — powers "Email to client" on
# generated documents (contract/confirmation/invoice). Without it, that
# button still shows but sending fails with a clear "not configured"
# message; everything else in the app works unaffected.
RESEND_API_KEY=""
# Must be on a domain verified in the Resend dashboard. Without it, mail
# sends from Resend's shared onboarding@resend.dev address, which only
# delivers to the Resend account's own inbox — fine for testing, not for
# real clients.
EMAIL_FROM="Travia <onboarding@resend.dev>"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"
# Password for the seeded "Transport team" demo carrier (reached via
# email/password login now that Google sign-in uses real OAuth).
SEED_DEMO_CARRIER_PASSWORD="demo1234"
